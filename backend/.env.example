NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/dental_clinic

JWT_ACCESS_SECRET=replace_with_32+_char_random_string
JWT_REFRESH_SECRET=replace_with_a_different_32+_char_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Field-level encryption (Section 6). 32-byte key, base64-encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=replace_me_base64_32_bytes

# Secret pepper for blind-index HMAC lookups (Section 6). Different from the encryption key.
BLIND_INDEX_SECRET=replace_me_random_string

PASSWORD_RESET_TOKEN_TTL_MINUTES=30

FRONTEND_URL=http://localhost:5173

EMAIL_PROVIDER=smtp
EMAIL_FROM="Dental Clinic <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

REMINDER_HOURS_BEFORE=48
NO_SHOW_GRACE_HOURS=6
WAITLIST_OFFER_TTL_HOURS=12
WAITLIST_OFFER_MAX_RECIPIENTS=3
RECALL_MONTHS_AFTER_VISIT=6
SLOT_LOCK_TTL_MINUTES=10

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
